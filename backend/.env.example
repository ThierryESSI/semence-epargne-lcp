# ============================================================
# SEMENCE EPARGNE — Variables d'environnement
# Copier en .env et compléter les valeurs
# ============================================================

DATABASE_URL="postgresql://postgres:VOTRE_MOT_DE_PASSE@localhost:5432/semence_epargne"

# IMPORTANT : générer un secret unique avec : node -e "console.log(require('crypto').randomBytes(64).toString('hex'))"
JWT_SECRET="REMPLACER_PAR_UN_SECRET_UNIQUE"
# Secret séparé pour les refresh tokens (recommandé: différent de JWT_SECRET)
# Si non défini, utilise JWT_SECRET comme fallback (déconseillé en prod)
JWT_REFRESH_SECRET=""
JWT_EXPIRES_IN="24h"
JWT_REFRESH_EXPIRES_IN="7d"

# Générer avec : node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
# ATTENTION : la clé par défaut rend l'encryption AES-256-GCM INOPÉRANTE
ENCRYPTION_KEY="REMPLACER_PAR_64_CARACTERES_HEX"
QR_SIGNING_KEY="REMPLACER_PAR_UN_SECRET_UNIQUE"

PORT=4000
NODE_ENV=development
FRONTEND_URL="http://localhost:3000"

# SMS SpecialSMS (specialsms.net) — votre clé API
SMS_SPKEY="VOTRE_CLE_SPECIALSMS_ICI"

# ─── SMS Entrant — Recharge zone rurale ──────────────────────────────
# Secret partagé avec SpecialSMS pour sécuriser le webhook
SMS_WEBHOOK_SECRET="lcp_sms_webhook_secret_changez_ceci_2026"

# ─── Compte Master (optionnel — surcharge seed.ts) ───────────────────
MASTER_EMAIL="master@lcp-microfinance.ci"
MASTER_TEL="2735960599"
MASTER_PWD="VotreMotDePasseSecurise2026!"

# ─── Notifications Email (Zoho/Gmail/SendGrid) ───────────────────────
# SMTP URL format : smtp://user:password@host:587 ou smtps://user:pass@host:465
SMTP_URL="smtp://votre-email@lcp-microfinance.ci:mot_de_passe@smtp.zoho.com:587"
SMTP_FROM="noreply@semenceep.ci"

# ─── WhatsApp Business API ───────────────────────────────────────────
# Option 1 — CallMeBot (gratuit, démarrage) : https://www.callmebot.com/blog/free-api-whatsapp-messages/
WHATSAPP_API_URL="https://api.callmebot.com/whatsapp.php"
WHATSAPP_API_KEY="VOTRE_CLE_CALLMEBOT"  # Numero: +2250708249583
# Option 2 — WhatsApp Business API Meta (production)
# WHATSAPP_API_URL="https://graph.facebook.com/v18.0/PHONE_ID/messages"
# WHATSAPP_API_KEY="VOTRE_CLE_CALLMEBOT"  # Numero: +2250708249583

# ─── SuperAdmin (créé via seed en production) ────────────────────────
SUPER_ADMIN_EMAIL="superadmin@lcp-microfinance.ci"
SUPER_ADMIN_TEL="2700000001"
SUPER_ADMIN_PWD="SuperAdmin@LCP2026!ChangeMe!"

# ─── Cloudinary (upload documents clients + rapports PDF) ────────────
# Gratuit jusqu'a 25 Go — inscrivez-vous sur cloudinary.com
CLOUDINARY_CLOUD_NAME="votre_cloud_name"
CLOUDINARY_API_KEY="votre_api_key"
CLOUDINARY_API_SECRET="votre_api_secret"

# ─── IA Rapports (Anthropic Claude) ─────────────────────────────
ANTHROPIC_API_KEY=sk-ant-api03-VOTRE_CLE_ICI

# WhatsApp Business API entrant (Option C)
WHATSAPP_VERIFY_TOKEN=SemenceEpWhatsApp2026
WHATSAPP_WEBHOOK_SECRET=SemenceEpWebhook2026
# App Secret Meta (recommandé) — permet de vérifier la signature HMAC X-Hub-Signature-256
# du webhook. À configurer à la fois ici et dans Meta (paramètres de l'app WhatsApp).
WHATSAPP_APP_SECRET=VOTRE_APP_SECRET_META_ICI
